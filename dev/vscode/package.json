{
  "name": "handlers",
  "displayName": "handlers (neozp)",
  "description": "Language client and syntax highlighting for handlers //h: route directives",
  "version": "0.1.0",
  "publisher": "epistemer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/epistemer/handlers"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "h-directives.go",
        "path": "./syntaxes/h-directives-go.tmLanguage.json",
        "injectTo": [
          "source.go"
        ]
      }
    ],
    "configuration": {
      "title": "handlers",
      "properties": {
        "handlers.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "go",
            "tool",
            "handlers",
            "lsp"
          ],
          "description": "Command and arguments used to run the handlers language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
